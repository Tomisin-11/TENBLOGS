# Copy this file to .env (or .env.local) and fill in your own values.
# Without these set, the Logo Library page still works — uploaded logos
# just get stored locally in the browser instead of on Cloudinary, so
# they won't sync across devices/browsers.

# Cloudinary → Settings → Upload → add an "Unsigned" upload preset,
# then paste your cloud name and the preset name below.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
